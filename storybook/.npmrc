# Several of the widget dependencies declare peer ranges the repo has long since moved past —
# react-native-qrcode-svg 6.0.6 asks for react-native-svg ^9, the repo pins 15.15.4 — so a strict
# install refuses to resolve. The repo root tolerates the same conflicts through pnpm's
# strict-peer-dependencies=false; this is the npm equivalent, and it keeps a plain `npm install`
# working here rather than requiring --legacy-peer-deps by hand.
legacy-peer-deps=true
